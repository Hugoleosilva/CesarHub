            },
            {
              "title": "Exclusão de dependente ou titular",
              "steps": [
                "Clique em “Acessar Plano de Saúde” e escolha “Exclusão”.",
                "Informe quem será excluído e a data desejada.",
                "Acompanhe pelo protocolo; o RH confirma por e-mail quando concluir."
              ]
            }
